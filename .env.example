# Copiar a .env y completar con los datos del proyecto de Supabase.
# Settings > API en el panel de Supabase.
#
# La anon key es pública por diseño: viaja al navegador. Lo que protege los
# datos es la RLS, no el secreto de esta clave.
# La service_role key NO va acá ni en ningún archivo del repo.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
